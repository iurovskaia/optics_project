import re
import time
import serial
import numpy as np
import matplotlib.pyplot as plt
import pynanovna

# =====================================================
# НАСТРОЙКИ
# =====================================================

ARDUINO_PORT = "COM6"
BAUDRATE = 115200

START_FREQ_MHZ = 100
STOP_FREQ_MHZ = 300
NUM_FREQ_POINTS = 101

ANALYSIS_FREQ_MHZ = 200

CALIBRATION_FILE = "calibration.json"

USE_TEST_DATA = False

# =====================================================
# КАЛИБРОВКА
# =====================================================

def do_calibration(vna):

    steps = ["open", "short", "load", "through"]
    names = ["OPEN", "SHORT", "LOAD", "THROUGH"]

    print("\n========== VNA CALIBRATION ==========\n")

    for step, name in zip(steps, names):

        input(
            f"\nConnect {name} standard and press ENTER...\n"
        )

        vna.calibration_step(step)

        print(f"{name} calibration done")

    print("\nCalculating calibration...")

    vna.calibrate()

    vna.save_calibration(CALIBRATION_FILE)

    print(
        f"\nCalibration saved to {CALIBRATION_FILE}"
    )


def load_or_calibrate(vna):

    choice = input(
        "\nLoad calibration [l] / "
        "New calibration [c] / "
        "Skip [s]: "
    ).strip().lower()

    # русская "с"
    if choice == "с":
        choice = "c"

    if choice == "l":

        vna.load_calibration(
            CALIBRATION_FILE
        )

        print(
            f"\nCalibration loaded from "
            f"{CALIBRATION_FILE}"
        )

    elif choice == "c":

        do_calibration(vna)

    elif choice == "s":

        print("\nCalibration skipped")

    else:

        print(
            "\nUnknown command.\n"
            "Starting new calibration."
        )

        do_calibration(vna)

# =====================================================
# ОБРАБОТКА S-ПАРАМЕТРОВ
# =====================================================

def convert_s_parameter_data(
    data,
    num_points
):

    if data is None:

        return {
            "magnitude": np.zeros(num_points),
            "phase": np.zeros(num_points)
        }

    if (
        isinstance(data, dict)
        and "magnitude" in data
        and "phase" in data
    ):

        return {
            "magnitude": np.array(
                data["magnitude"]
            ),
            "phase": np.array(
                data["phase"]
            )
        }

    if (
        isinstance(
            data,
            (list, tuple, np.ndarray)
        )
        and len(data) > 0
    ):

        if isinstance(data[0], complex):

            return {
                "magnitude": np.abs(data),
                "phase": np.angle(
                    data,
                    deg=True
                )
            }

        else:

            return {
                "magnitude": np.array(data),
                "phase": np.zeros_like(data)
            }

    return {
        "magnitude": np.zeros(num_points),
        "phase": np.zeros(num_points)
    }

# =====================================================
# ВВОД ПАРАМЕТРОВ
# =====================================================

X_POINTS = int(
    input("Enter X points: ")
)

Y_POINTS = int(
    input("Enter Y points: ")
)

# =====================================================
# ПОДКЛЮЧЕНИЕ ARDUINO
# =====================================================

ser = serial.Serial(
    ARDUINO_PORT,
    BAUDRATE,
    timeout=1
)

time.sleep(2)

print("\nArduino connected")

# =====================================================
# ЧАСТОТЫ
# =====================================================

start_freq = START_FREQ_MHZ * 1e6
stop_freq = STOP_FREQ_MHZ * 1e6

frequencies = np.linspace(
    start_freq,
    stop_freq,
    NUM_FREQ_POINTS
)

freq_idx = np.argmin(
    np.abs(
        frequencies
        - ANALYSIS_FREQ_MHZ * 1e6
    )
)

# =====================================================
# ПОДКЛЮЧЕНИЕ VNA
# =====================================================

vna = None

if not USE_TEST_DATA:

    print("\nConnecting VNA...")

    vna = pynanovna.VNA(
        vna_index=0,
        logging_level="info"
    )

    if not vna.is_connected():

        raise RuntimeError(
            "VNA not connected"
        )

    print("\nVNA connected")
    print(vna.info())

    print("\nSetting sweep...")

    vna.set_sweep(
        start=int(start_freq),
        stop=int(stop_freq),
        points=NUM_FREQ_POINTS
    )

    time.sleep(0.5)

    # =========================================
    # КАЛИБРОВКА
    # =========================================

    load_or_calibrate(vna)

# =====================================================
# ГОТОВНОСТЬ К СКАНИРОВАНИЮ
# =====================================================

print(
    "\n===================================="
)
print("Scanner is ready.")
print("Place the probe.")
print("Are you ready?")
print("Press ENTER to start scanning.")
print(
    "====================================\n"
)

input()

# =====================================================
# МАССИВ ИНТЕНСИВНОСТИ
# =====================================================

intensity_map = np.full(
    (Y_POINTS, X_POINTS),
    np.nan
)

# =====================================================
# ОТПРАВКА ПАРАМЕТРОВ ARDUINO
# =====================================================

ser.write(
    f"{X_POINTS}\n".encode()
)

ser.flush()

time.sleep(0.5)

ser.write(
    f"{Y_POINTS}\n".encode()
)

ser.flush()

time.sleep(0.5)

# =====================================================
# ЗАПУСК СКАНИРОВАНИЯ
# =====================================================

ser.write(b"START\n")

ser.flush()

print("\nScan started\n")

# =====================================================
# ОСНОВНОЙ ЦИКЛ
# =====================================================

while True:

    line = ser.readline().decode(
        errors="ignore"
    ).strip()

    if not line:
        continue

    print("Arduino:", line)

    # =================================================
    # ИЗМЕРЕНИЕ
    # =================================================

    if line.startswith("MEASURE"):

        match = re.search(
            r"X=(\d+)\s+Y=(\d+)",
            line
        )

        if match is None:
            continue

        x = int(match.group(1))
        y = int(match.group(2))

        print(
            f"\nMeasuring point "
            f"X={x}, Y={y}"
        )

        # =============================================
        # ТЕСТОВЫЕ ДАННЫЕ
        # =============================================

        if USE_TEST_DATA:

            E = (
                np.sin(x / 3)
                + np.cos(y / 3)
            )

            intensity = E ** 2

        # =============================================
        # ИЗМЕРЕНИЕ VNA
        # =============================================

        else:

            result = vna.sweep()

            if (
                result is None
                or len(result) != 3
            ):

                print("Bad sweep")

                continue

            s11_raw, s21_raw, freqs = result

            s21 = convert_s_parameter_data(
                s21_raw,
                NUM_FREQ_POINTS
            )

            E = s21["magnitude"][
                freq_idx
            ]

            intensity = np.abs(E) ** 2

        intensity_map[y, x] = intensity

        print(
            f"Intensity |E|² = "
            f"{intensity}"
        )

    # =================================================
    # КОНЕЦ СКАНИРОВАНИЯ
    # =================================================

    elif line == "SCAN FINISHED":

        print("\nScan finished")

        break

# =====================================================
# СОХРАНЕНИЕ
# =====================================================

np.save(
    "intensity_map.npy",
    intensity_map
)

np.savetxt(
    "intensity_map.csv",
    intensity_map,
    delimiter=","
)

print("\nSaved intensity_map.npy")
print("Saved intensity_map.csv")

# =====================================================
# ТЕПЛОКАРТА
# =====================================================

plt.figure(figsize=(8, 6))

plt.imshow(
    intensity_map,
    origin="lower",
    extent=[0, 200, 0, 150],
    aspect="auto",
    cmap="jet"
)

plt.colorbar(
    label="|E|²"
)

plt.xlabel("X (mm)")
plt.ylabel("Y (mm)")

plt.title(
    f"Field intensity map\n"
    f"{ANALYSIS_FREQ_MHZ} MHz"
)

plt.savefig(
    "intensity_heatmap.png",
    dpi=300
)

plt.show()

print(
    "\nSaved intensity_heatmap.png"
)

ser.close()
