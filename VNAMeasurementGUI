class VNAMeasurementGUI:
    """Графический интерфейс для работы с VNA и моторами"""

    def __init__(self):
        self.root = tk.Tk()
        self.root.title("VNA Анализатор - Синхронизированное сканирование")
        self.root.geometry("1700x950")
        self.root.configure(bg='#1a1a2e')

        self.motor = MotorController()
        self.mapper = SParameterMapper(logging_level='info')

        self.is_connected = False
        self.is_measuring = False
        self.measurement_thread = None

        self.start_freq = tk.DoubleVar(value=100)
        self.stop_freq = tk.DoubleVar(value=300)
        self.num_points = tk.IntVar(value=101)
        self.analysis_freq = tk.DoubleVar(value=200)

        self.progress_value = tk.IntVar(value=0)
        self.status_text = tk.StringVar(value="🟢 Готов к работе")

        self.plotter_h_amp = None
        self.plotter_v_amp = None
        self.plotter_h_phase = None
        self.plotter_v_phase = None
        self.motor_panel = None
        self.info_panel = None

        self.setup_ui()
        self.setup_plots()

    def setup_ui(self):
        """Настройка пользовательского интерфейса"""
        main_frame = tk.Frame(self.root, bg='#1a1a2e')
        main_frame.pack(fill=tk.BOTH, expand=True, padx=10, pady=10)

        left_panel = tk.Frame(main_frame, width=400, bg='#1a1a2e')
        left_panel.pack(side=tk.LEFT, fill=tk.Y, padx=5, pady=5)
        left_panel.pack_propagate(False)

        center_panel = tk.Frame(main_frame, bg='#1a1a2e')
        center_panel.pack(side=tk.LEFT, fill=tk.BOTH, expand=True, padx=5, pady=5)

        right_panel = tk.Frame(main_frame, width=380, bg='#1a1a2e')
        right_panel.pack(side=tk.RIGHT, fill=tk.Y, padx=5, pady=5)
        right_panel.pack_propagate(False)

        self.notebook = ttk.Notebook(center_panel)
        self.notebook.pack(fill=tk.BOTH, expand=True)

        self.tab_h_amp = tk.Frame(self.notebook, bg='#1a1a2e')
        self.tab_v_amp = tk.Frame(self.notebook, bg='#1a1a2e')
        self.tab_h_phase = tk.Frame(self.notebook, bg='#1a1a2e')
        self.tab_v_phase = tk.Frame(self.notebook, bg='#1a1a2e')

        self.notebook.add(self.tab_h_amp, text="🌊 H-Амплитуда")
        self.notebook.add(self.tab_v_amp, text="🌊 V-Амплитуда")
        self.notebook.add(self.tab_h_phase, text="🌀 H-Фаза")
        self.notebook.add(self.tab_v_phase, text="🌀 V-Фаза")

        self.setup_vna_panel(left_panel)
        self.motor_panel = MotorControlPanel(right_panel, self.motor)
        self.info_panel = InfoPanel(right_panel)

    def setup_plots(self):
        """Однократное создание всех графиков"""
        self.plotter_h_amp = OptimizedPlotter(self.tab_h_amp)
        self.fig_h_amp, self.canvas_h_amp, self.toolbar_h_amp = self.plotter_h_amp.create_figure()
        self.ax_h_amp = self.fig_h_amp.add_subplot(111)

        self.plotter_v_amp = OptimizedPlotter(self.tab_v_amp)
        self.fig_v_amp, self.canvas_v_amp, self.toolbar_v_amp = self.plotter_v_amp.create_figure()
        self.ax_v_amp = self.fig_v_amp.add_subplot(111)

        self.plotter_h_phase = OptimizedPlotter(self.tab_h_phase)
        self.fig_h_phase, self.canvas_h_phase, self.toolbar_h_phase = self.plotter_h_phase.create_figure()
        self.ax_h_phase = self.fig_h_phase.add_subplot(111)

        self.plotter_v_phase = OptimizedPlotter(self.tab_v_phase)
        self.fig_v_phase, self.canvas_v_phase, self.toolbar_v_phase = self.plotter_v_phase.create_figure()
        self.ax_v_phase = self.fig_v_phase.add_subplot(111)

