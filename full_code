        def do_update():
            try:
                self.x_label.config(text=f"X: {position[0]:.2f} мм")
                self.y_label.config(text=f"Y: {position[1]:.2f} мм")

                mag_h = s12_h['magnitude'][0] if len(s12_h['magnitude']) > 0 else 1e-6
                mag_h_db = 20 * np.log10(np.maximum(abs(mag_h), 1e-6))
                self.magnitude_h_label.config(text=f"📊 Амплитуда: {mag_h_db:.2f} dB")
                phase_h = s12_h['phase'][0] if len(s12_h['phase']) > 0 else 0
                self.phase_h_label.config(text=f"🌀 Фаза: {phase_h:.2f} °")

                mag_v = s12_v['magnitude'][0] if len(s12_v['magnitude']) > 0 else 1e-6
                mag_v_db = 20 * np.log10(np.maximum(abs(mag_v), 1e-6))
                self.magnitude_v_label.config(text=f"📊 Амплитуда: {mag_v_db:.2f} dB")
                phase_v = s12_v['phase'][0] if len(s12_v['phase']) > 0 else 0
                self.phase_v_label.config(text=f"🌀 Фаза: {phase_v:.2f} °")

                self.freq_label.config(text=f"📡 Частота: {freq_mhz:.1f} МГц")
                if total_points > 0:
                    self.points_label.config(text=f"📌 Всего точек: {total_points}")
            except Exception as e:
                print(f"Ошибка обновления информации: {e}")

        self.parent.after_idle(do_update)


