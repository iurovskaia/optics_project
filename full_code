class MotorController:
    """Класс для управления моторами через ESP32 (режим змейка)"""

    def __init__(self):
        self.serial_conn = None
        self.is_connected = False
        self.measurement_count = 0
        self.total_measurements = 0
        self.stop_flag = False

    def find_port(self):
        """Автоматическое определение порта ESP32"""
        ports = serial.tools.list_ports.comports()
        for port in ports:
            if any(x in port.description for x in ["USB", "Espressif", "CP210", "CH340", "CH9102"]):
                return port.device
        return None

    def connect(self, port=None):
        """Подключение к ESP32"""
        port = 'COM7'

        try:
            self.serial_conn = serial.Serial(port, 115200, timeout=1)
            time.sleep(2)

            self.serial_conn.reset_input_buffer()
            self.serial_conn.reset_output_buffer()

            self.is_connected = True
            print(f"✓ Моторы подключены к {port}")
            return True

        except Exception as e:
            print(f"Ошибка подключения моторов: {e}")
            return False

    def disconnect(self):
        """Отключение от ESP32"""
        if self.serial_conn:
            self.send_command('s')
            time.sleep(0.5)
            self.serial_conn.close()
            self.is_connected = False
            print("Моторы отключены")

    def send_command(self, cmd, wait_response=True, timeout=30):
        """Отправка команды на ESP32 и ожидание ответа"""
        if not self.serial_conn or not self.is_connected:
            print("Моторы не подключены")
            return None

        try:
            # Очищаем буфер перед отправкой
            self.serial_conn.reset_input_buffer()

            # Отправляем команду
            self.serial_conn.write(f"{cmd}\n".encode())
            self.serial_conn.flush()

            if not wait_response:
                return None

            # Ждем ответа
            start_time = time.time()
            responses = []

            while time.time() - start_time < timeout:
                if self.serial_conn.in_waiting:
                    line = self.serial_conn.readline().decode().strip()
                    if line:
                        responses.append(line)
                        print(f"  ESP32: {line}")

                        # Для команд N1 и N2 ждем подтверждения
                        if cmd.startswith('N') and "Error" not in line:
                            # Если получили ответ без ошибки, возвращаем
                            return responses

                        if "COMPLETED" in line or "STOPPED" in line:
                            return responses
                time.sleep(0.05)

            if not responses:
                print(f"Нет ответа на команду {cmd}")

            return responses if responses else None

        except Exception as e:
            print(f"Ошибка отправки команды: {e}")
            return None

    def configure_scan(self, n1, n2):
        """Настройка параметров сканирования"""
        print(f"Настройка сканирования: N1={n1}, N2={n2}")

        # Отправляем N1 и ждем подтверждения
        response1 = self.send_command(f"N1{n1}", timeout=5)
        time.sleep(0.5)  # Пауза между командами

        # Отправляем N2 и ждем подтверждения
        response2 = self.send_command(f"N2{n2}", timeout=5)
        time.sleep(0.5)

        # Проверяем, что обе команды успешно выполнены
        if response1 and response2:
            print(f"Параметры сканирования установлены: N1={n1}, N2={n2}")
        else:
            print("Ошибка при установке параметров сканирования")

        self.total_measurements = n1 * n2
        print(f"Всего точек измерения: {self.total_measurements}")

        return self.total_measurements

    def start_meander(self):
        """Запуск движения по змейке"""
        print("Запуск движения по змейке...")
        self.measurement_count = 0
        self.send_command("g", timeout=600)

    def emergency_stop(self):
        """Экстренная остановка"""
        self.stop_flag = True
        self.send_command("s")

    def home(self):
        """Домашняя позиция"""
        self.send_command("h")

    def get_status(self):
        """Получение статуса"""
        self.send_command("i")


class OptimizedPlotter:
    """Оптимизированный класс для быстрой отрисовки графиков"""

    def __init__(self, parent):
        self.parent = parent
        self.fig = None
        self.canvas = None
        self.toolbar = None
        self.initialized = False
        self.current_im = None
        self.current_colorbar = None
        self.fixed_extent = None
        self.full_X_grid = None
        self.full_Y_grid = None
        self.full_Z = None
        self.x_points = None
        self.y_points = None

    def create_figure(self):
        """Создание фигуры один раз"""
        self.fig = plt.figure(figsize=(10, 8), dpi=100, facecolor='#1e1e2e')
        self.canvas = FigureCanvasTkAgg(self.fig, self.parent)
        self.toolbar = NavigationToolbar2Tk(self.canvas, self.parent)
        self.toolbar.update()
        self.canvas.get_tk_widget().pack(fill=tk.BOTH, expand=True)
        self.canvas.draw()
        self.initialized = True
        return self.fig, self.canvas, self.toolbar

    def initialize_grid(self, x_min, x_max, y_min, y_max, step_x, step_y):
        """Инициализация сетки для всей области сканирования"""
        self.x_points = np.arange(x_min, x_max + step_x / 2, step_x)
        self.y_points = np.arange(y_min, y_max + step_y / 2, step_y)

        self.full_X_grid, self.full_Y_grid = np.meshgrid(self.x_points, self.y_points)
        self.full_Z = np.full_like(self.full_X_grid, np.nan)

        x_min_mm = x_min * 1000
        x_max_mm = x_max * 1000
        y_min_mm = y_min * 1000
        y_max_mm = y_max * 1000
        self.fixed_extent = [x_min_mm, x_max_mm, y_min_mm, y_max_mm]

        return self.full_X_grid * 1000, self.full_Y_grid * 1000

    def update_point(self, x, y, value, ax, title, cmap, cbar_label):
        """Обновление одной точки на карте"""
        if not self.initialized or self.full_X_grid is None:
            return

        def do_update():
            try:
                xi = np.argmin(np.abs(self.x_points - x))
                yi = np.argmin(np.abs(self.y_points - y))

                self.full_Z[yi, xi] = value

                if self.current_im is None:
                    self.current_im = ax.imshow(self.full_Z, origin='lower',
                                                extent=self.fixed_extent,
                                                cmap=cmap, aspect='auto',
                                                interpolation='bilinear')
                    self.current_im.cmap.set_bad('lightgray', 1.0)
                    ax.set_title(title, fontsize=12, fontweight='bold', color='white')
                    ax.set_xlabel('X (мм)', fontsize=11, color='white')
                    ax.set_ylabel('Y (мм)', fontsize=11, color='white')
                    ax.tick_params(colors='white')
                    ax.set_xlim(self.fixed_extent[0], self.fixed_extent[1])
                    ax.set_ylim(self.fixed_extent[2], self.fixed_extent[3])
                    ax.set_facecolor('#1a1a2e')

                    if self.current_colorbar is None:
                        self.current_colorbar = plt.colorbar(self.current_im, ax=ax,
                                                             label=cbar_label, shrink=0.8)
                        self.current_colorbar.ax.yaxis.label.set_color('white')
                        self.current_colorbar.ax.tick_params(colors='white')
                else:
                    self.current_im.set_data(self.full_Z)
                    valid_data = self.full_Z[~np.isnan(self.full_Z)]
                    if len(valid_data) > 0:
                        self.current_im.set_clim(np.min(valid_data), np.max(valid_data))

                    if self.current_colorbar is not None:
                        self.current_colorbar.update_normal(self.current_im)

                ax.set_title(f'{title}\nТочек: {np.sum(~np.isnan(self.full_Z))}',
                             fontsize=12, fontweight='bold', color='white')
                self.canvas.draw_idle()

            except Exception as e:
                print(f"Ошибка обновления точки: {e}")
                traceback.print_exc()

        try:
            root = self.parent.winfo_toplevel()
            root.after(0, do_update)
        except:
            do_update()

    def reset(self):
        """Сброс для новой серии измерений"""
        if self.current_colorbar is not None:
            try:
                self.current_colorbar.remove()
            except:
                pass
        self.current_im = None
        self.current_colorbar = None
        self.full_X_grid = None
        self.full_Y_grid = None
        self.full_Z = None
        self.fixed_extent = None
        self.x_points = None
        self.y_points = None


class SParameterMapper:
    """Класс для работы с VNA"""

    def __init__(self, vna_index=0, logging_level='info'):
        self.vna = None
        self.vna_index = vna_index
        self.logging_level = logging_level
        self.frequencies = None
        self.s12_data_h = []
        self.s12_data_v = []
        self.positions = []
        self.start_freq = None
        self.stop_freq = None
        self.num_points = None
        self.freq_idx = 0

    def connect_vna(self):
        """Подключение к VNA"""
        try:
            self.vna = pynanovna.VNA(
                vna_index=self.vna_index,
                logging_level=self.logging_level
            )
            if self.vna.is_connected():
                info = self.vna.info()
                print(f"VNA подключен успешно: {info}")
                return True
            return False
        except Exception as e:
            print(f"Ошибка подключения: {e}")
            return False

    def set_frequency_range(self, start_freq_mhz, stop_freq_mhz, num_points=101):
        """Установка диапазона частот"""
        self.start_freq = start_freq_mhz * 1e6
        self.stop_freq = stop_freq_mhz * 1e6
        self.num_points = num_points
        self.frequencies = np.linspace(self.start_freq, self.stop_freq, num_points)

        if self.vna and self.vna.is_connected():
            try:
                self.vna.set_sweep(start=int(self.start_freq), stop=int(self.stop_freq), points=num_points)
                time.sleep(0.5)
            except Exception as e:
                print(f"Ошибка установки sweep: {e}")
        return self.frequencies

    def calibrate_step(self, step):
        """Выполнение одного шага калибровки"""
        if not self.vna or not self.vna.is_connected():
            raise Exception("VNA не подключен")
        self.vna.calibration_step(step)

    def finalize_calibration(self):
        """Завершение калибровки"""
        if not self.vna or not self.vna.is_connected():
            raise Exception("VNA не подключен")
        self.vna.calibrate()

    def save_calibration(self, filename="calibration.json"):
        """Сохранение калибровки"""
        self.vna.save_calibration(filename)

    def load_calibration(self, filename="calibration.json"):
        """Загрузка калибровки"""
        self.vna.load_calibration(filename)

    def measure_single_sweep(self):
        """Выполнение одного измерения"""
        try:
            result = self.vna.sweep()
            if result is None or len(result) != 3:
                return None, None

            s11_raw, s21_raw, frequencies = result
            if s21_raw is None:
                return None, None

            s12_data = self._convert_s_parameter_data(s21_raw)

            if self.frequencies is None and frequencies is not None:
                self.frequencies = np.array(frequencies)
                self.num_points = len(frequencies)

            return s12_data, frequencies

        except Exception as e:
            print(f"Ошибка измерения: {e}")
            return None, None

    def _convert_s_parameter_data(self, data):
        """Преобразование данных S-параметров"""
        if data is None:
            return {'magnitude': np.zeros(self.num_points if self.num_points else 101),
                    'phase': np.zeros(self.num_points if self.num_points else 101)}

        if isinstance(data, dict) and 'magnitude' in data and 'phase' in data:
            return {
                'magnitude': np.array(data['magnitude']),
                'phase': np.array(data['phase'])
            }

        elif isinstance(data, (list, tuple, np.ndarray)) and len(data) > 0:
            if isinstance(data[0], complex):
                return {
                    'magnitude': np.abs(data),
                    'phase': np.angle(data, deg=True)
                }
            else:
                return {
                    'magnitude': np.array(data),
                    'phase': np.zeros_like(data)
                }
        else:
            return {
                'magnitude': np.zeros(self.num_points if self.num_points else 101),
                'phase': np.zeros(self.num_points if self.num_points else 101)
            }

    def create_amplitude_map(self, data, freq_idx, x_coords_mm, y_coords_mm):
        """Создание карты амплитуд"""
        if len(self.positions) < 4:
            return None

        try:
            x_coords = np.array(x_coords_mm) / 1000.0
            y_coords = np.array(y_coords_mm) / 1000.0

            s12_amp = np.array([d['magnitude'][freq_idx] for d in data])
            with np.errstate(divide='ignore'):
                s12_amp_db = 20 * np.log10(np.maximum(np.abs(s12_amp), 1e-6))

            unique_x = np.unique(x_coords)
            unique_y = np.unique(y_coords)

            if len(unique_x) < 2 or len(unique_y) < 2:
                if len(x_coords) > 1:
                    step = np.mean(np.diff(np.sort(x_coords))) / 2
                else:
                    step = 0.01

                if len(unique_x) == 1:
                    unique_x = [unique_x[0] - step, unique_x[0], unique_x[0] + step]
                if len(unique_y) == 1:
                    unique_y = [unique_y[0] - step, unique_y[0], unique_y[0] + step]

            max_points = 100
            if len(unique_x) > max_points:
                step = len(unique_x) // max_points
                unique_x = unique_x[::step]
            if len(unique_y) > max_points:
                step = len(unique_y) // max_points
                unique_y = unique_y[::step]

            X_grid, Y_grid = np.meshgrid(unique_x, unique_y)

            try:
                S12_map = griddata((x_coords, y_coords), s12_amp_db, (X_grid, Y_grid), method='linear')
                S12_map = np.nan_to_num(S12_map, nan=np.min(s12_amp_db) if len(s12_amp_db) > 0 else -100)
            except:
                S12_map = griddata((x_coords, y_coords), s12_amp_db, (X_grid, Y_grid), method='nearest')
                S12_map = np.nan_to_num(S12_map, nan=np.min(s12_amp_db) if len(s12_amp_db) > 0 else -100)

            freq_value = self.frequencies[freq_idx] / 1e6 if self.frequencies is not None else 200

            return {
                'X': X_grid * 1000,
                'Y': Y_grid * 1000,
                'S12': S12_map,
                'freq': freq_value,
                'points': len(self.positions)
            }
        except Exception as e:
            print(f"Ошибка создания карты амплитуд: {e}")
            return None

    def create_phase_map(self, data, freq_idx, x_coords_mm, y_coords_mm):
        """Создание карты фаз"""
        if len(self.positions) < 4:
            return None

        try:
            x_coords = np.array(x_coords_mm) / 1000.0
            y_coords = np.array(y_coords_mm) / 1000.0

            s12_phase = np.array([d['phase'][freq_idx] for d in data])

            unique_x = np.unique(x_coords)
            unique_y = np.unique(y_coords)

            if len(unique_x) < 2 or len(unique_y) < 2:
                if len(x_coords) > 1:
                    step = np.mean(np.diff(np.sort(x_coords))) / 2
                else:
                    step = 0.01

                if len(unique_x) == 1:
                    unique_x = [unique_x[0] - step, unique_x[0], unique_x[0] + step]
                if len(unique_y) == 1:
                    unique_y = [unique_y[0] - step, unique_y[0], unique_y[0] + step]

            max_points = 100
            if len(unique_x) > max_points:
                step = len(unique_x) // max_points
                unique_x = unique_x[::step]
            if len(unique_y) > max_points:
                step = len(unique_y) // max_points
                unique_y = unique_y[::step]

            X_grid, Y_grid = np.meshgrid(unique_x, unique_y)

            try:
                S12_map = griddata((x_coords, y_coords), s12_phase, (X_grid, Y_grid), method='linear')
                S12_map = np.nan_to_num(S12_map, nan=0)
            except:
                S12_map = griddata((x_coords, y_coords), s12_phase, (X_grid, Y_grid), method='nearest')
                S12_map = np.nan_to_num(S12_map, nan=0)

            freq_value = self.frequencies[freq_idx] / 1e6 if self.frequencies is not None else 200

            return {
                'X': X_grid * 1000,
                'Y': Y_grid * 1000,
                'S12': S12_map,
                'freq': freq_value,
                'points': len(self.positions)
            }
        except Exception as e:
            print(f"Ошибка создания карты фаз: {e}")
            return None

    def save_data(self, filename=None):
        """Сохранение данных в файл"""
        if filename is None:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            filename = f"s12_data_{timestamp}.npz"

        positions_array = np.array(self.positions)
        s12_magnitudes_h = np.array([data['magnitude'] for data in self.s12_data_h])
        s12_phases_h = np.array([data['phase'] for data in self.s12_data_h])
        s12_magnitudes_v = np.array([data['magnitude'] for data in self.s12_data_v])
        s12_phases_v = np.array([data['phase'] for data in self.s12_data_v])

        np.savez(filename,
                 positions=positions_array,
                 frequencies=self.frequencies,
                 s12_magnitudes_h=s12_magnitudes_h,
                 s12_phases_h=s12_phases_h,
                 s12_magnitudes_v=s12_magnitudes_v,
                 s12_phases_v=s12_phases_v,
                 freq_idx=self.freq_idx,
                 start_freq=self.start_freq,
                 stop_freq=self.stop_freq,
                 num_points=self.num_points)

        return filename


class MotorControlPanel:
    """Панель управления моторами"""

    def __init__(self, parent, motor_controller):
        self.parent = parent
        self.motor = motor_controller
        self.frame = tk.LabelFrame(parent, text="Управление моторами",
                                   font=('Arial', 12, 'bold'),
                                   bg='#2a2a4e', fg='white', bd=2, relief=tk.RAISED)
        self.frame.pack(fill=tk.X, padx=5, pady=5)

        self.setup_ui()

    def setup_ui(self):
        """Настройка интерфейса панели моторов"""
        status_frame = tk.Frame(self.frame, bg='#2a2a4e')
        status_frame.pack(fill=tk.X, padx=10, pady=5)

        self.status_label = tk.Label(status_frame, text="⚫ Моторы: не подключены",
                                     bg='#2a2a4e', fg='#ff8888', font=('Arial', 10))
        self.status_label.pack(side=tk.LEFT)

        tk.Button(status_frame, text="Подключить", command=self.connect_motors,
                  bg='#44aa44', fg='white', font=('Arial', 9), padx=10).pack(side=tk.RIGHT, padx=5)

        params_frame = tk.LabelFrame(self.frame, text="Параметры сканирования",
                                     bg='#2a2a4e', fg='white', font=('Arial', 10))
        params_frame.pack(fill=tk.X, padx=10, pady=5)

        tk.Label(params_frame, text="Точек по X:", bg='#2a2a4e', fg='white').grid(row=0, column=0, padx=5)
        self.n1_var = tk.IntVar(value=15)
        tk.Entry(params_frame, textvariable=self.n1_var, width=8).grid(row=0, column=1, padx=5)

        tk.Label(params_frame, text="Точек по Y:", bg='#2a2a4e', fg='white').grid(row=0, column=2, padx=5)
        self.n2_var = tk.IntVar(value=10)
        tk.Entry(params_frame, textvariable=self.n2_var, width=8).grid(row=0, column=3, padx=5)

        self.apply_btn = tk.Button(params_frame, text="Применить", command=self.apply_scan_params,
                                   bg='#44aaff', fg='white', font=('Arial', 9))
        self.apply_btn.grid(row=0, column=4, padx=5)

        btn_frame = tk.Frame(self.frame, bg='#2a2a4e')
        btn_frame.pack(fill=tk.X, padx=10, pady=5)

        tk.Button(btn_frame, text="🏠 HOME", command=self.home_motors,
                  bg='#44aaff', fg='white', font=('Arial', 9), width=10).pack(side=tk.LEFT, padx=5)
        tk.Button(btn_frame, text="⏹ СТОП", command=self.stop_motors,
                  bg='#ff4444', fg='white', font=('Arial', 9), width=10).pack(side=tk.LEFT, padx=5)

    def connect_motors(self):
        """Подключение моторов"""
        if self.motor.connect():
            self.status_label.config(text="🟢 Моторы: подключены", fg="#88ff88")
            messagebox.showinfo("Успех", "Моторы подключены успешно!")
        else:
            messagebox.showerror("Ошибка", "Не удалось подключить моторы")

    def apply_scan_params(self):
        """Применение параметров сканирования"""
        n1 = self.n1_var.get()
        n2 = self.n2_var.get()

        # Блокируем кнопку на время отправки
        self.apply_btn.config(state=tk.DISABLED, text="Отправка...")
        self.parent.update_idletasks()

        try:
            total = self.motor.configure_scan(n1, n2)
            messagebox.showinfo("Инфо", f"Настроено сканирование: {n1}×{n2} = {total} точек")
        except Exception as e:
            messagebox.showerror("Ошибка", f"Ошибка настройки: {e}")
        finally:
            self.apply_btn.config(state=tk.NORMAL, text="Применить")

    def home_motors(self):
        """Домашняя позиция"""
        self.motor.home()

    def stop_motors(self):
        """Экстренная остановка"""
        self.motor.emergency_stop()


class InfoPanel:
    """Панель информации о текущем измерении"""

    def __init__(self, parent):
        self.parent = parent
        self.frame = tk.Frame(parent, bg='#2a2a4e', relief=tk.RAISED, bd=2)
        self.frame.pack(fill=tk.BOTH, expand=True)

        self.setup_ui()

